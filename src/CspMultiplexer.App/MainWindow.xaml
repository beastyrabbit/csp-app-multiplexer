<Window x:Class="CspMultiplexer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CSP Mux"
        Icon="pack://application:,,,/Assets/csp-mux.ico"
        Style="{StaticResource AppWindowStyle}"
        Width="460"
        MinWidth="460"
        MaxWidth="460"
        Height="620"
        MinHeight="620"
        MaxHeight="620"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ToolTipService.InitialShowDelay="400"
        ToolTipService.ShowDuration="20000"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40"
                        ResizeBorderThickness="0"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="1"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- A null Background makes DragMove miss the hit test and the window undraggable. -->
    <Grid Grid.Row="0"
          Height="40"
          Background="{StaticResource WindowBrush}"
          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="8"/>
      </Grid.ColumnDefinitions>

      <!-- The wordmark, the dot and the connection word must NOT be hit-test-visible in
           chrome: that is what makes the whole left two-thirds of the bar drag. -->
      <TextBlock Grid.Column="1"
                 Style="{StaticResource BodyStrongTextStyle}"
                 VerticalAlignment="Center"
                 Text="CSP Mux"
                 TextWrapping="NoWrap"/>

      <Ellipse x:Name="ConnectionDot"
               Grid.Column="3"
               Width="8"
               Height="8"
               VerticalAlignment="Center"
               Fill="{StaticResource SubtleBrush}"/>

      <!-- No ToolTip: an element inside the caption region receives no mouse input. -->
      <TextBlock x:Name="ConnectionText"
                 Grid.Column="5"
                 Style="{StaticResource LabelTextStyle}"
                 MaxWidth="96"
                 VerticalAlignment="Center"
                 Text="Offline"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap"
                 AutomationProperties.LiveSetting="Polite"/>

      <ToggleButton x:Name="PinButton"
                    Grid.Column="7"
                    Style="{StaticResource TitleToggleStyle}"
                    Checked="PinButton_Toggled"
                    Unchecked="PinButton_Toggled"
                    ToolTip="Always on top (off)"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    AutomationProperties.Name="Always on top">
        <Grid Width="12" Height="12">
          <Path Stretch="None"
                SnapsToDevicePixels="True"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                Data="M 4.5,2.5 L 5,6.5 L 8,6.5 L 8.5,2.5 Z"/>
          <Path Stretch="None"
                SnapsToDevicePixels="True"
                StrokeThickness="1"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                Data="M 6.5,6.5 L 6.5,11 M 3,2.5 L 10,2.5"/>
        </Grid>
      </ToggleButton>

      <Button x:Name="SettingsButton"
              Grid.Column="8"
              Style="{StaticResource TitleButtonStyle}"
              Click="SettingsButton_Click"
              ToolTip="Settings"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              AutomationProperties.Name="Open settings">
        <!-- Filled gear, not a stroked one: at 12px a 1px-stroked gear collapses into a
             grey annulus with texture noise, whereas a solid silhouette with an EvenOdd
             centre hole keeps eight legible teeth. Byte-identical to the Companion's. -->
        <Grid Width="12" Height="12">
          <Path Stretch="None"
                SnapsToDevicePixels="True"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Data="F0 M 4.58,2.1 L 4.79,0.53 L 7.21,0.53 L 7.42,2.1 L 7.75,2.24 L 9.01,1.28 L 10.72,2.99 L 9.76,4.25 L 9.9,4.58 L 11.47,4.79 L 11.47,7.21 L 9.9,7.42 L 9.76,7.75 L 10.72,9.01 L 9.01,10.72 L 7.75,9.76 L 7.42,9.9 L 7.21,11.47 L 4.79,11.47 L 4.58,9.9 L 4.25,9.76 L 2.99,10.72 L 1.28,9.01 L 2.24,7.75 L 2.1,7.42 L 0.53,7.21 L 0.53,4.79 L 2.1,4.58 L 2.24,4.25 L 1.28,2.99 L 4.25,2.24 Z M 4.05,6 A 1.95,1.95 0 1 0 7.95,6 A 1.95,1.95 0 1 0 4.05,6 Z"/>
        </Grid>
      </Button>

      <Button Grid.Column="9"
              Style="{StaticResource TitleButtonStyle}"
              Click="MinimizeButton_Click"
              ToolTip="Minimize"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              AutomationProperties.Name="Minimize">
        <Path Width="12"
              Height="12"
              Stretch="None"
              SnapsToDevicePixels="True"
              StrokeThickness="1"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              Data="M 1,6.5 L 11,6.5"/>
      </Button>

      <!-- The taskbar-mode values. ApplyHostMode rewrites both to "Hide to tray" when the
           glyph stops meaning what it says. -->
      <Button x:Name="CloseButton"
              Grid.Column="10"
              Style="{StaticResource CloseButtonStyle}"
              Click="CloseButton_Click"
              ToolTip="Close"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              AutomationProperties.Name="Close">
        <Path Width="12"
              Height="12"
              Stretch="None"
              SnapsToDevicePixels="True"
              StrokeThickness="1"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5"/>
      </Button>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource DividerBrush}"/>

    <Grid Grid.Row="2" Margin="16,12,16,12">

      <!-- ══ MAIN VIEW — 56 + 12 + 323 + 12 + 100 + 12 + 40 = 555 ══════════════ -->
      <Grid x:Name="MainView">
        <Grid.RowDefinitions>
          <RowDefinition Height="56"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- The instruction strip says what you should do; the status strip says what the
             app is doing. No state renders the same sentence twice. -->
        <Border Grid.Row="0"
                Style="{StaticResource StripStyle}"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}">
          <TextBlock x:Name="InstructionText"
                     Style="{StaticResource CaptionTextStyle}"
                     Height="32"
                     VerticalAlignment="Center"
                     Text="Open CSP Companion Mode, then scan its QR."
                     AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <Border x:Name="QrFrame"
                Grid.Row="2"
                Style="{StaticResource QrFrameStyle}"
                Padding="18">
          <!-- NearestNeighbor is mandatory: WPF's default Fant filtering blurs module
               edges at fractional DPI scale factors badly enough to make the code
               unscannable. -->
          <Image x:Name="QrImage"
                 Stretch="Uniform"
                 StretchDirection="Both"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <Border x:Name="StatusPanel"
                Grid.Row="4"
                Style="{StaticResource StripStyle}"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="28"/>
              <RowDefinition Height="4"/>
              <RowDefinition Height="50"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="StatusDot"
                       Grid.Column="0"
                       Width="8"
                       Height="8"
                       VerticalAlignment="Center"
                       Fill="{StaticResource SubtleBrush}"/>
              <TextBlock x:Name="StatusText"
                         Grid.Column="2"
                         Style="{StaticResource BodyStrongTextStyle}"
                         VerticalAlignment="Center"
                         Text="Not sharing"
                         TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap"
                         AutomationProperties.LiveSetting="Polite"/>
              <Border x:Name="ClientCountBadge"
                      Grid.Column="3"
                      Style="{StaticResource PillBadgeStyle}"
                      VerticalAlignment="Center">
                <TextBlock x:Name="ClientCountText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="0 apps"
                           TextWrapping="NoWrap"/>
              </Border>
            </Grid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <!-- 50 = 3 reserved lines x LineHeight 16 + 2px slack; the +2 is what stops
                   UseLayoutRounding costing the third line at 125%. -->
              <TextBlock x:Name="DetailText"
                         Grid.Column="2"
                         Style="{StaticResource CaptionTextStyle}"
                         Height="50"
                         TextTrimming="CharacterEllipsis"
                         AutomationProperties.LiveSetting="Polite"/>
            </Grid>

            <ProgressBar x:Name="BusyIndicator"
                         Grid.Row="3"
                         Height="3"
                         Margin="16,8,0,0"
                         HorizontalAlignment="Stretch"
                         IsHitTestVisible="False"
                         IsIndeterminate="{Binding IsVisible, RelativeSource={RelativeSource Self}}"
                         Visibility="Collapsed"/>
          </Grid>
        </Border>

        <!-- A collapsing column is correct by construction; rewriting Location and Size
             at three sites is only correct while every transition remembers both. -->
        <Grid Grid.Row="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SecondaryActionColumn" Width="0"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="SecondaryButton"
                  Grid.Column="0"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Height="40"
                  Click="SecondaryButton_Click"
                  Content="Cancel"
                  Visibility="Collapsed"/>
          <Button x:Name="PrimaryButton"
                  Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Click="PrimaryButton_Click"
                  Content="Scan CSP QR"
                  IsDefault="True"/>
        </Grid>
      </Grid>

      <!-- ══ SETTINGS VIEW — §5.4-R ════════════════════════════════════════════ -->
      <Grid x:Name="SettingsView" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="28"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BackButton"
                  Grid.Column="0"
                  Style="{StaticResource TitleButtonStyle}"
                  Click="BackButton_Click"
                  ToolTip="Back (Esc)"
                  AutomationProperties.Name="Back">
            <Path Width="12"
                  Height="12"
                  Stretch="None"
                  SnapsToDevicePixels="True"
                  StrokeThickness="1"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M 7.5,2 L 3.5,6 L 7.5,10"/>
          </Button>
          <TextBlock Grid.Column="2"
                     Style="{StaticResource TitleTextStyle}"
                     VerticalAlignment="Center"
                     Text="Settings"/>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Padding="0,0,8,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border x:Name="SettingsNotice"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,12"
                    Background="{StaticResource ErrorStatusBrush}"
                    BorderBrush="{StaticResource ErrorBrush}"
                    Visibility="Collapsed">
              <TextBlock x:Name="SettingsNoticeText"
                         Style="{StaticResource CaptionTextStyle}"
                         Foreground="{StaticResource TextBrush}"
                         AutomationProperties.LiveSetting="Assertive"/>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Connection scope"/>
                <ComboBox x:Name="NetworkScopePicker"
                          Margin="0,4,0,0"
                          IsEnabled="{Binding IsStopped}"
                          SelectionChanged="NetworkScopePicker_SelectionChanged"
                          ToolTip="Stop sharing to change the network."
                          ToolTipService.ShowOnDisabled="True"
                          AutomationProperties.Name="Connection scope"/>
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,0"
                           Text="Loopback keeps the proxy on this PC. A private network lets phones reach it."/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource BodyStrongTextStyle}"
                             Text="Hide QR after first connection"/>
                  <TextBlock Style="{StaticResource CaptionTextStyle}"
                             Margin="0,4,0,0"
                             Text="The proxy keeps running."/>
                </StackPanel>
                <CheckBox x:Name="AutoHideQrToggle"
                          Grid.Column="2"
                          Style="{StaticResource ToggleSwitchStyle}"
                          VerticalAlignment="Center"
                          Click="AutoHideQrToggle_Click"
                          AutomationProperties.Name="Hide QR after first connection"/>
              </Grid>
            </Border>

            <!-- Window card, §11.10. Byte-identical to the Companion's. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="System tray"/>
                  <TextBlock Style="{StaticResource CaptionTextStyle}"
                             Margin="0,4,0,0"
                             Text="Close hides the window. Exit from the tray icon."/>
                </StackPanel>
                <CheckBox x:Name="TrayModeToggle"
                          Grid.Column="2"
                          Style="{StaticResource ToggleSwitchStyle}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="System tray"
                          Click="TrayModeToggle_Click"/>
              </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock x:Name="AboutText" Style="{StaticResource CaptionTextStyle}"/>
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <!-- NoWrap + CharacterEllipsis are load-bearing: a real %LOCALAPPDATA%
                       path is ~90 characters and would wrap to three lines. -->
                  <TextBlock x:Name="SettingsPathText"
                             Grid.Column="0"
                             Style="{StaticResource BodyTextStyle}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap"/>
                  <Button x:Name="ShowSettingsFileButton"
                          Grid.Column="2"
                          Style="{StaticResource LinkButtonStyle}"
                          VerticalAlignment="Center"
                          Click="ShowSettingsFileButton_Click"
                          Content="Show file"
                          ToolTip="Show settings.json in Explorer"
                          AutomationProperties.Name="Show the settings file in File Explorer"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
